PORT=7575
CONTROL_PLANE_PORT=7580
NODE_ENV=development
SESSION_SECRET=change-me
DATA_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
DATA_ENCRYPTION_KEY_VERSION=v1
# Set only while migrating ciphertext created by the legacy SESSION_SECRET scheme
LEGACY_SESSION_SECRET=
DATABASE_URL=postgresql://sholidstream:sholidstream@postgres:5432/sholidstream
DATABASE_SSL=false
DATABASE_POOL_MAX=20
REDIS_URL=redis://redis:6379
QUEUE_PREFIX=sholidstream
SCHEDULER_TICK_MS=5000
WATCHDOG_TICK_MS=15000
STREAM_WORKER_CONCURRENCY=2
STREAM_WORKER_MAX_STREAMS=2
STREAM_WORKER_HEARTBEAT_MS=15000
STREAM_WORKER_LEASE_MS=45000
STREAM_WORKER_REGION=default
STREAM_WORKER_KEY=
FFMPEG_PATH=/usr/bin/ffmpeg
STORAGE_DRIVER=local
LOCAL_STORAGE_ROOT=./data/storage
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=sholidstream
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio123
S3_FORCE_PATH_STYLE=true
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:7580/api/v1/integrations/youtube/callback
YOUTUBE_DAILY_QUOTA_BUDGET=10000
