PORT=7575
NODE_ENV=development
SESSION_SECRET=change-me
DATA_ENCRYPTION_KEY=change-me-with-32-plus-random-bytes

# PostgreSQL SaaS control-plane database
DATABASE_URL=postgresql://sholidstream:sholidstream@postgres:5432/sholidstream
DATABASE_SSL=false
DATABASE_POOL_MAX=20

# Redis / BullMQ
REDIS_URL=redis://redis:6379
QUEUE_PREFIX=sholidstream

# Object storage: local | s3
STORAGE_DRIVER=local
LOCAL_STORAGE_ROOT=./data/storage
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=sholidstream
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio123
S3_FORCE_PATH_STYLE=true
