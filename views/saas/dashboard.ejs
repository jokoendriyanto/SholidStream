<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>SholidStream Control Plane</title><link rel="stylesheet" href="/css/saas-control-plane.css"></head><body><main class="shell"><header><div><span class="eyebrow">SHOLIDSTREAM</span><h1>Streaming Control Plane</h1><p>Workers, sessions, billing and incidents in one operational view.</p></div><div class="status">Production architecture</div></header><section class="auth"><label>API Key <input id="token" type="password" placeholder="ssk_..."></label><button id="connect">Connect</button></section><section id="cards" class="grid"><article><span>Workspaces</span><strong id="workspaces">—</strong></article><article><span>Active streams</span><strong id="streams">—</strong></article><article><span>Healthy workers</span><strong id="workers">—</strong></article><article><span>Open incidents</span><strong id="incidents">—</strong></article></section><section class="panel"><h2>Recent sessions</h2><pre id="sessions">Connect with a scoped API key.</pre></section></main><script>async function api(path){const token=document.querySelector('#token').value;const r=await fetch('/api/v1'+path,{headers:{Authorization:'Bearer '+token}});if(!r.ok)throw new Error(await r.text());return r.json()}document.querySelector('#connect').onclick=async()=>{try{const sessions=await api('/streams');document.querySelector('#sessions').textContent=JSON.stringify(sessions.items,null,2);try{const o=await api('/admin/overview');workspaces.textContent=o.workspaces;streams.textContent=o.activeStreams;workers.textContent=o.healthyWorkers;incidents.textContent=o.openIncidents}catch{}}catch(e){document.querySelector('#sessions').textContent=e.message}}</script></body></html>